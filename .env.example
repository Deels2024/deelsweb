# demo — встроенные данные; auto — API с fallback; live — только реальный API
NEXT_PUBLIC_DEELS_API_MODE=demo
NEXT_PUBLIC_DEELS_API_URL=/api/deels
NEXT_PUBLIC_DEELS_API_PREFIX=/api
NEXT_PUBLIC_DEELS_API_TIMEOUT_MS=15000
# cookie — Laravel Sanctum/session; bearer — access token в sessionStorage
NEXT_PUBLIC_DEELS_AUTH_MODE=cookie
NEXT_PUBLIC_DEELS_CSRF_PATH=/sanctum/csrf-cookie
# Серверная переменная, без /api в конце
DEELS_BACKEND_URL=https://deels.ru
